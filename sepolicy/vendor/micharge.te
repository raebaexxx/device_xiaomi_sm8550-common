type hal_micharge_default, domain;
type hal_micharge_default_exec, exec_type, vendor_file_type, file_type;
type hal_micharge_hwservice, hwservice_manager_type;

hal_attribute(micharge)
hal_server_domain(hal_micharge_default, hal_micharge)
add_hwservice(hal_micharge_default, hal_micharge_hwservice)
init_daemon_domain(hal_micharge_default)

hal_client_domain(system_server, hal_micharge)
hal_client_domain(system_app, hal_micharge)

allow hal_micharge_default sysfs:dir r_dir_perms;
allow hal_micharge_default sysfs:file rw_file_perms;
allow hal_micharge_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_micharge_default sysfs_batteryinfo:file rw_file_perms;
allow hal_micharge_default sysfs_batteryinfo:lnk_file r_file_perms;
allow hal_micharge_default sysfs_usb:dir r_dir_perms;
allow hal_micharge_default sysfs_usb:file rw_file_perms;
allow hal_micharge_default vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_micharge_default vendor_sysfs_battery_supply:file rw_file_perms;
allow hal_micharge_default vendor_sysfs_battery_supply:lnk_file r_file_perms;
allow hal_micharge_default vendor_sysfs_usb_supply:dir r_dir_perms;
allow hal_micharge_default vendor_sysfs_usb_supply:file rw_file_perms;
allow hal_micharge_default vendor_sysfs_usb_supply:lnk_file r_file_perms;
