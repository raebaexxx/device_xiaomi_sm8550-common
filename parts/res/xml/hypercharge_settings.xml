<?xml version="1.0" encoding="utf-8"?>
<Preference xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/hypercharge_title">

        <com.android.settingslib.widget.MainSwitchPreference
            app:key="hypercharge_status"
            app:title="@string/hypercharge_title"
            app:summary="@string/hypercharge_summary"
            app:persistent="false" />

        <Preference
            app:key="hypercharge_warning"
            app:title="@string/hypercharge_title"
            app:summary="@string/hypercharge_warning"
            app:selectable="false"
            app:persistent="false"
            app:dependency="hypercharge_status" />

        <ListPreference
            app:key="hypercharge_limit"
            app:title="@string/hypercharge_limit_title"
            app:summary="%s"
            app:entries="@array/hypercharge_limit_entries"
            app:entryValues="@array/hypercharge_limit_values"
            app:defaultValue=""
            app:dependency="hypercharge_status" />

        <Preference
            app:key="hypercharge_dump_state"
            app:title="@string/hypercharge_dump_title"
            app:summary="@string/hypercharge_dump_summary" />

    </PreferenceCategory>

</Preference>