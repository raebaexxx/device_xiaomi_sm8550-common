# CameraX
ro.camerax.extensions.enabled=true

# Audio
# System audio properties must live in /system/build.prop: vendor_init is not
# allowed to set default_prop from /vendor/build.prop.
audio.sys.noisy.broadcast.delay=600
audio.sys.offload.pstimeout.secs=3

# Bluetooth
bluetooth.auto_connect_profiles.enabled=true

# HWUI
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
ro.hwui.drop_shadow_cache_size=6
ro.hwui.gradient_cache_size=1
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.r_buffer_cache_size=8
ro.hwui.text_large_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_small_cache_height=1024
ro.hwui.text_small_cache_width=1024
ro.hwui.texture_cache_flushrate=0.4
ro.hwui.texture_cache_size=72

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1

# Media
media.settings.xml?=/odm/etc/media_profiles_kalama.xml

# RIL
ril.subscription.types=NV,RUIM
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so

# Debug overhead reduction
debug.stagefright.rtp=false
debug.stagefright.fps=false
debug.stagefright.enableshaping=0
debug.stagefright.omx-debug=0
debug.stagefright.profilecodec=0
debug.stagefright.experiments=0
debug.sys.looper_stats_enabled=false
debug.atrace.tags.enableflags=0
debug.orientation.log=false
debug.art.monitor.app=false
debug.generate-debug-info=false
debug.tflite.trace=0
debug.assert=0
debug.checkjni=0
debug.nn.vlog=0
debug.jni.logging=0
debug.sensors=0
debug.synclog=0
debug.vulkan.enable_callback=0
debug.angle.validation=false
debug.graphics.gpu.profiler.perfetto=false
debug.renderengine.skia_tracing_enabled=false
debug.renderengine.skia_use_perfetto_track_events=false
debug.renderengine.skia_atrace_enabled=false
debug.egl.finish=false
debug.egl.traceGpuCompletion=false
debug.egl.callstack=false
debug.egl.trace=0
debug.hwui.skip_eglmanager_telemetry=true
